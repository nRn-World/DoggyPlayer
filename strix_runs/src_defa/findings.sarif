        {
          "ruleId": "strix-coverage/provider-controlled-url-origin-in-the-ssrf-bridge",
          "ruleIndex": 10,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Provider-controlled URL origin in the SSRF bridge — Ruled out: Provider-response fields (series.id, s.stream_id, s.id, ep.id) feeding iptv-fetch URLs at src/App.tsx:1592,1650-1721,3855\n\nAll these values are substituted only into a path segment appended to a constant `${baseUrl}` origin (`/player_api.php?...series_id=`, `/series/<user>/<pass>/<id>.<ext>`, `/live/...`, `/movie/...`), so a malicious provider's response can alter the path but not the scheme, host or port of the bridge request. No response field is used as a whole URL. The `movie_data`/`episodes` URL-bearing fields are not read at all. Effectively a fixed-origin template, so provider response content alone cannot retarget the bridge."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Provider-response fields (series.id, s.stream_id, s.id, ep.id) feeding iptv-fetch URLs at src/App.tsx:1592,1650-1721,3855"
