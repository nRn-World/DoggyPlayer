                        "endLine": 1283
                      },
                      "insertedContent": {
                        "text": "// Fetch from keyvalue.immanuel.co using the same derived hash as the writer\n      const codeKey = (window as any).require('crypto')\n        .createHash('sha256')\n        .update(`doggy-share-v1|${activationCode.trim()}`)\n        .digest('hex');\n      const raw = await ipcRenderer.invoke('iptv-fetch', `https://keyvalue.immanuel.co/api/KeyVal/GetValue/${KV_APP_KEY}/${codeKey}`);"
                      }
