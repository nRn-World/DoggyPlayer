                    "text": "const encoded = encodeForKV({ url: xtreamUrl, user: xtreamUser, pass: xtreamPass });\n       \n       // Store via keyvalue.immanuel.co\n       const result = await ipcRenderer.invoke('iptv-fetch', `https://keyvalue.immanuel.co/api/KeyVal/UpdateValue/${KV_APP_KEY}/${generateCode}/${encoded}`);"
                  }
                }
              },
