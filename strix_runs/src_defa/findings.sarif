          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/App.tsx"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 1314,
                        "endLine": 1317
                      },
                      "insertedContent": {
                        "text": "// Encrypt credentials with a key derived from the sharing code before\n       // they leave the device. The public store must never see plaintext, and\n       // the record key must be a hash so the short code cannot be enumerated.\n       const codeKey = (window as any).require('crypto')\n         .createHash('sha256')\n         .update(`doggy-share-v1|${generateCode}`)\n         .digest('hex');\n       const encoded = await encryptCredsForShare(\n         { url: xtreamUrl, user: xtreamUser, pass: xtreamPass },\n         generateCode\n       );\n\n       // Store via keyvalue.immanuel.co under the derived hash, not the raw code\n       const result = await ipcRenderer.invoke('iptv-fetch', `https://keyvalue.immanuel.co/api/KeyVal/UpdateValue/${KV_APP_KEY}/${codeKey}/${encoded}`);"
                      }
