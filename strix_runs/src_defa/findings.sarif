          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "electron/main.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 179,
                        "endLine": 189
                      },
                      "insertedContent": {
                        "text": "function resolveLocalMediaPath(filePath) {\r\n  if (!filePath || typeof filePath !== 'string') return '';\r\n  let cleanPath = filePath;\r\n  if (cleanPath.startsWith('file:///')) cleanPath = cleanPath.slice(8);\r\n  else if (cleanPath.startsWith('file://')) cleanPath = cleanPath.slice(7);\r\n  if (process.platform === 'win32') {\r\n    try { cleanPath = decodeURIComponent(cleanPath); } catch (_) {}\r\n    cleanPath = cleanPath.replace(/\\//g, '\\\\');\r\n  }\r\n  return cleanPath;\r\n}\r\n\r\n/**\r\n * Canonical path of a request-supplied local media file, or '' when it is not\r\n * inside one of `mediaRoots`. Every filesystem use of req.query.path must go\r\n * through this: the token only proves the caller saw a log line, it says\r\n * nothing about which files may be read.\r\n */\r\nfunction resolveConfinedMediaPath(filePath, mediaRoots) {\r\n  const cleanPath = resolveLocalMediaPath(filePath);\r\n  if (!cleanPath) return '';\r\n  let realPath;\r\n  try { realPath = fs.realpathSync(cleanPath); } catch (_) { return ''; }\r\n  for (const root of mediaRoots) {\r\n    if (!root) continue;\r\n    let realRoot;\r\n    try { realRoot = fs.realpathSync(root); } catch (_) { continue; }\r\n    const rel = path.relative(realRoot, realPath);\r\n    if (rel && !rel.startsWith('..') && !path.isAbsolute(rel)) return realPath;\r\n  }\r\n  return '';\r\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "electron/main.js"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 716,
                        "endLine": 731
                      },
                      "insertedContent": {
                        "text": "server.get('/stream', async (req, res) => {\r\n      if (req.query.token !== streamToken) return res.status(403).send('Forbidden');\r\n      const videoPath = req.query.path;\r\n      const transcode = req.query.transcode === 'true';\r\n      const parsedStart = parseFloat(req.query.start);\r\n      const start = Number.isFinite(parsedStart) && parsedStart > 0 ? parsedStart : 0;\r\n      // Remote items are only served through the re-encoding pipe — that is how\r\n      // an IPTV/VOD stream with an undecodable video track gets a picture back.\r\n      const isRemote = /^https?:\\/\\//i.test(videoPath || '');\r\n      // A token-holder may only read inside the media roots. Same 404 for\r\n      // \"missing\" and \"outside root\" so the endpoint cannot probe the filesystem.\r\n      const localPath = isRemote ? '' : resolveConfinedMediaPath(videoPath, streamMediaRoots());\r\n\r\n      if (!videoPath || (!isRemote && !localPath)) {\r\n        return res.status(404).send('File not found');\r\n      }\r\n\r\n      let fileSize = 0;\r\n      if (!isRemote) {\r\n        try { fileSize = fs.statSync(localPath).size; } catch (_) { return res.status(404).send('File not found'); }\r\n      }"
                      }
                    }
                  ]
                },
