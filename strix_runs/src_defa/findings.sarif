              "coverage_outcome": "no_issue_found",
              "risk_area": "Node integration in a second window with no navigation guard",
              "surface": "electron/telemetry.js openStatsWindow() webPreferences and statistics window navigation (telemetry.js:150-173)",
              "recorded_by": "Electron Posture & Telemetry Auditor",
              "source": "agent_reported"
            }
          }
