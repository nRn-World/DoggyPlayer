                      "insertedContent": {
                        "text": "mainWindow.setMenuBarVisibility(false);\n  mainWindow.autoHideMenuBar = true;\n\n  // The player document must never be replaced by content from a stream URL.\n  // Only the packaged UI (or the dev server) may be the main frame's origin.\n  const appOrigin = process.env.NODE_ENV === 'development' || !app.isPackaged\n    ? 'http://127.0.0.1:3000'\n    : pathToFileURL(path.join(__dirname, '../dist/index.html')).toString();\n  const isAppUrl = (target) => {\n    try {\n      const u = new URL(target);\n      const a = new URL(appOrigin);\n      if (a.protocol === 'file:') return u.protocol === 'file:' && u.pathname === a.pathname;\n      return u.origin === a.origin;\n    } catch {\n      return false;\n    }\n  };\n  mainWindow.webContents.on('will-navigate', (event, target) => {\n    if (!isAppUrl(target)) event.preventDefault();\n  });\n  mainWindow.webContents.on('will-redirect', (event, target) => {\n    if (!isAppUrl(target)) event.preventDefault();\n  });\n  mainWindow.webContents.setWindowOpenHandler(() => ({ action: 'deny' }));"
