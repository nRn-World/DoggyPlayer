        {
          "ruleId": "strix-coverage/local-file-read-gopher-protocol-smuggling-cloud-credential-theft",
          "ruleIndex": 11,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Local file read / gopher protocol smuggling / cloud credential theft — Ruled out: Non-HTTP schemes and cloud metadata endpoints through iptv-fetch\n\nNode 24 global `fetch` rejects `file:///etc/passwd` and `gopher://127.0.0.1:6379/_PING` with `fetch failed` in the live PoC, so there is no local file read and no raw-socket (Redis RESP / FastCGI) smuggling via this bridge. Metadata endpoints ARE reachable over HTTP but require a header (`Metadata-Flavor`, `Metadata: true`, IMDSv2 token PUT) - the bridge allows arbitrary caller headers and methods, so IMDSv1 and GCP/Azure metadata are retrievable; that is folded into vuln-0001 rather than being separate."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Non-HTTP schemes and cloud metadata endpoints through iptv-fetch"
                }
